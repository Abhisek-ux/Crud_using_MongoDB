<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CRUD</title>
    <link rel="stylesheet" href="/css/semantic.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="wrapper">
        <div class="ui massive menu">
            <div class="ui container">
               <div class="header item">
                <a href="/" class="link">Home</a>
            </div>
            <a class="item">
                Blogs
            </a>
            <a class="item">
                Contact
            </a>
            <a class="item">
                About
            </a>
            </div>
        </div>

        <br>
        <br>
        <br>
        <div class="ui container">
            <form action="/edit/<%-club._id %>" class="ui form" method="post">
                <div class="ui three fields">
                <div class="field">
                    <label for="label" class="ui header green">Enter the club name</label>
                    <input type="text" name="name" placeholder="Enter club name" value="<%- club.name %>" id="name">
                </div>
                <div class="field">
                    <label for="label" class="ui header green">Enter the players name</label>
                    <input type="text" name="players" placeholder="Enter players name" value="<%- club.players %>" id="players">
                </div>
                <div class="field">
                    <label for="label" class="ui header green">Enter the coach name</label>
                    <input type="text" name="coach" placeholder="Enter coach name" value="<%- club.coach %>" id="coach">
                </div>
            </div>
            <div class="fluid field">
                <button type="submit"  class="ui  button green fluid" >Save</button>
            </div>
            </form>
            <br>
            <br>
            <br>
 
        </div>
    </div>

    <script src="/js/semantic.min.js"></script>
</body>

</html>